{
  "id": "devkit.oa-debug",
  "name": "OA 设备解锁",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "src/index.cjs",
  "description": "OA 登录、设备挑战码取口令、注入与结果验证；每个实例拥有独立配置，支持手动解锁与自动应答（扣键补发）。",
  "configSchema": {
    "type": "object",
    "properties": {
      "deviceActions": {
        "type": "object",
        "title": "设备动作配置",
        "additionalProperties": true
      },
      "profileId": {
        "type": "string",
        "title": "手动动作 ID"
      },
      "auto": {
        "type": "boolean",
        "title": "允许自动应答",
        "default": true
      }
    },
    "required": [
      "deviceActions"
    ],
    "additionalProperties": false
  },
  "actions": [
    {
      "id": "run",
      "label": "执行设备动作"
    }
  ],
  "autoRespond": true,
  "capabilities": [
    "serial.read",
    "serial.write",
    "serial.exclusive",
    "auth.session"
  ]
}
