{
  "id": "devkit.text-hex-responder",
  "name": "文本 / HEX 自动应答",
  "version": "2.0.0",
  "apiVersion": 2,
  "minHostVersion": "0.1.10",
  "transports": [
    "serial",
    "ssh",
    "net"
  ],
  "entry": "src/index.cjs",
  "description": "独立多传输设备插件：支持串口、SSH 与网络调试的文本行或 HEX 字节序列多规则自动应答。",
  "configSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "title": "匹配模式",
        "enum": [
          "text",
          "hex"
        ],
        "default": "text"
      },
      "match": {
        "type": "string",
        "title": "默认匹配内容",
        "minLength": 1,
        "maxLength": 4096,
        "default": "PING"
      },
      "response": {
        "type": "string",
        "title": "默认回复内容",
        "maxLength": 4096,
        "default": "PONG"
      },
      "rules": {
        "type": "array",
        "title": "扩展匹配规则",
        "description": "可选附加多条匹配规则，按顺序命中并回复。",
        "default": [],
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "match": {
              "type": "string",
              "title": "匹配内容",
              "minLength": 1,
              "maxLength": 4096,
              "default": "PING"
            },
            "response": {
              "type": "string",
              "title": "回复内容",
              "maxLength": 4096,
              "default": "PONG"
            }
          },
          "required": [
            "match",
            "response"
          ],
          "additionalProperties": false
        }
      },
      "newline": {
        "type": "string",
        "title": "文本回复换行",
        "enum": [
          "none",
          "cr",
          "lf",
          "crlf"
        ],
        "default": "crlf",
        "x-visibleWhen": {
          "field": "mode",
          "equals": "text"
        }
      },
      "ignoreCase": {
        "type": "boolean",
        "title": "文本忽略大小写",
        "default": false,
        "x-visibleWhen": {
          "field": "mode",
          "equals": "text"
        }
      },
      "replyDelayMs": {
        "type": "integer",
        "title": "回复延时（毫秒）",
        "minimum": 0,
        "maximum": 5000,
        "default": 0
      },
      "maxBufferBytes": {
        "type": "integer",
        "title": "接收缓存上限（字节）",
        "minimum": 256,
        "maximum": 65536,
        "default": 8192
      }
    },
    "required": [
      "mode",
      "match",
      "response",
      "newline",
      "ignoreCase",
      "replyDelayMs",
      "maxBufferBytes"
    ],
    "additionalProperties": false
  },
  "actions": [
    {
      "id": "send",
      "label": "发送配置的回复"
    },
    {
      "id": "reset",
      "label": "清空协议缓存并取消待发延时"
    }
  ],
  "autoRespond": true,
  "capabilities": [
    "stream.read",
    "stream.write"
  ]
}
